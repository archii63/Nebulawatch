"""
Veltrix
-------
Minimal API health monitoring tool.

Features:
- Monitor multiple HTTP endpoints
- Measure response latency
- Detect unhealthy services
- JSON report generation
- Configurable timeout
- Clean CLI interface

Requirements:
    pip install requests
"""

from __future__ import annotations

import argparse
import json
import time
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
from typing import List

import requests


@dataclass
class HealthResult:
    name: str
    url: str
    status: str
    http_status: int | None
    latency_ms: float | None
    error: str | None
    checked_at: str


class Veltrix:
    def __init__(self, timeout: float = 5.0):
        self.timeout = timeout
        self.session = requests.Session()
        self.session.headers.update(
            {
                "User-Agent": "Veltrix/1.0",
                "Accept": "application/json",
            }
        )

    def check(self, name: str, url: str) -> HealthResult:
        checked_at = datetime.now(timezone.utc).isoformat()

        start = time.perf_counter()

        try:
            response = self.session.get(
                url,
                timeout=self.timeout,
                allow_redirects=True,
            )

            latency_ms = round(
                (time.perf_counter() - start) * 1000,
                2,
            )

            status = (
                "healthy"
                if 200 <= response.status_code < 400
                else "unhealthy"
            )

            return HealthResult(
                name=name,
                url=url,
                status=status,
                http_status=response.status_code,
                latency_ms=latency_ms,
                error=None,
                checked_at=checked_at,
            )

        except requests.RequestException as exc:
            latency_ms = round(
                (time.perf_counter() - start) * 1000,
                2,
            )

            return HealthResult(
                name=name,
                url=url,
                status="unreachable",
                http_status=None,
                latency_ms=latency_ms,
                error=str(exc),
                checked_at=checked_at,
            )

    def monitor(self, services: List[dict]) -> List[HealthResult]:
        results = []

        for service in services:
            result = self.check(
                name=service["name"],
                url=service["url"],
            )

            results.append(result)

            self._print_result(result)

        return results

    @staticmethod
    def _print_result(result: HealthResult) -> None:
        latency = (
            f"{result.latency_ms} ms"
            if result.latency_ms is not None
            else "N/A"
        )

        http_status = (
            str(result.http_status)
            if result.http_status is not None
            else "-"
        )

        print(
            f"[{result.status.upper():11}] "
            f"{result.name:20} "
            f"HTTP={http_status:3} "
            f"LATENCY={latency}"
        )


def load_services(path: str) -> List[dict]:
    with open(path, "r", encoding="utf-8") as file:
        data = json.load(file)

    if not isinstance(data, list):
        raise ValueError("Configuration must contain a JSON array.")

    for service in data:
        if "name" not in service or "url" not in service:
            raise ValueError(
                "Each service must contain 'name' and 'url'."
            )

    return data


def save_report(
    results: List[HealthResult],
    output_path: str,
) -> None:
    report = {
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "total_services": len(results),
        "healthy": sum(
            result.status == "healthy"
            for result in results
        ),
        "unhealthy": sum(
            result.status == "unhealthy"
            for result in results
        ),
        "unreachable": sum(
            result.status == "unreachable"
            for result in results
        ),
        "services": [asdict(result) for result in results],
    }

    with open(output_path, "w", encoding="utf-8") as file:
        json.dump(
            report,
            file,
            indent=2,
            ensure_ascii=False,
        )


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Veltrix - Lightweight API Health Monitor"
    )

    parser.add_argument(
        "-c",
        "--config",
        default="services.json",
        help="Path to service configuration.",
    )

    parser.add_argument(
        "-o",
        "--output",
        default="health-report.json",
        help="Path for the generated JSON report.",
    )

    parser.add_argument(
        "-t",
        "--timeout",
        type=float,
        default=5.0,
        help="HTTP request timeout in seconds.",
    )

    args = parser.parse_args()

    try:
        services = load_services(args.config)

        monitor = Veltrix(timeout=args.timeout)

        print("\nVeltrix API Health Monitor")
        print("-" * 72)

        results = monitor.monitor(services)

        save_report(results, args.output)

        print("-" * 72)
        print(f"Report saved to: {args.output}\n")

    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"Configuration error: {exc}")
        raise SystemExit(1)


if __name__ == "__main__":
    main()
